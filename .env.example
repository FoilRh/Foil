# Every env var the API, services and scripts read, with placeholders. Never put real values
# here. Deploys read deploy/<network>.env (gitignored; made by scripts/testnet-env.ts) and push
# each service only its own subset. Web app vars: apps/web/.env.example.

# --- Chain and deployment (api, services, scripts) ---
# Robinhood Chain RPC (public testnet endpoint shown; use a paid endpoint on mainnet).
RPC_URL=https://rpc.testnet.chain.robinhood.com
# 4663 = RHC mainnet, 46630 = RHC testnet.
CHAIN_ID=46630
# Contract addresses from contracts/deployments/<chainId>.json.
POOL_ADDRESS=0x0000000000000000000000000000000000000000
USDG_ADDRESS=0x0000000000000000000000000000000000000000
GATE_ADDRESS=0x0000000000000000000000000000000000000000
# First block the indexers scan from (deployments/<chainId>.json startBlock).
START_BLOCK=0
# Collector Crypt contracts for browser mode (optional).
CARD_NFT_ADDRESS=
CC_VAULT_ADDRESS=
# Comma-separated Collector Crypt shipping payee addresses (optional).
SHIPPING_PAYEES=
# Postgres (Supabase transaction pooler, port 6543).
DATABASE_URL=postgres://user:password@host:6543/postgres

# --- apps/api ---
# OHTTP gateway key: id 0-255, X25519 keys as 64 hex chars.
OHTTP_KEY_ID=1
OHTTP_PRIVATE_KEY=<64-hex>
OHTTP_PUBLIC_KEY=<64-hex>
# Public OHTTP key config (hex) the web build pins; used by scripts/testnet-rip.ts.
OHTTP_KEY_CONFIG=<hex>
# Internal service URLs and their bearer tokens (each token distinct, >= 32 chars).
RELAYER_URL=http://localhost:8081
RELAYER_ADDRESS=0x0000000000000000000000000000000000000000
RELAYER_TOKEN=<random-32+>
OPERATOR_URL=http://localhost:8082
OPERATOR_TOKEN=<random-32+>
# Comma-separated ppoi-node URLs and one token per node, same order.
PPOI_URLS=http://localhost:8083,http://localhost:8084
PPOI_TOKENS=<random-32+>,<random-32+>

# --- services/* (each reads only its own) ---
# Port for the Bun server (default 8080).
PORT=8080
# Bearer for the service's internal route (relayer /relay, operator /reveal, ppoi /attest).
INTERNAL_TOKEN=<random-32+>
# Relayer, round-operator and ppoi-node signing keys.
RELAYER_PRIVATE_KEY=0x<64-hex>
OPERATOR_PRIVATE_KEY=0x<64-hex>
PPOI_PRIVATE_KEY=0x<64-hex>
# ppoi-node sanctions list (JSON array of addresses).
BLOCKLIST_URL=https://raw.githubusercontent.com/0xB10C/ofac-sanctioned-digital-currency-addresses/lists/sanctioned_addresses_ETH.json
# Loop intervals (ms): round-operator tick, indexer poll and snapshot.
TICK_MS=15000
POLL_MS=15000
SNAPSHOT_MS=300000
# ohttp-relay: gateway to forward to and the web origins allowed to call it.
GATEWAY_URL=http://localhost:8080/gateway
ALLOWED_ORIGINS=http://localhost:3000
# tunnel-relay: comma-separated hosts it may tunnel to.
ALLOWED_HOSTS=collectorcrypt.com,thecardwall.com

# --- Vercel (scripts/vercel/*) ---
# Which service scripts/vercel/entry.ts runs: api, relayer, round-operator, ppoi-node, indexer, ohttp-relay.
SERVICE=api
# The project's own /tick bearer (deploy.ts derives one per project from the master below).
TICK_TOKEN=<random-32+>
# Set by Vercel at runtime; disables in-process loops in favour of /tick.
VERCEL=
# Vercel team for deploy.ts.
VERCEL_SCOPE=<team-slug>
# testnet (default) or mainnet, for deploy.ts, testnet-status.ts and monitor.ts.
NETWORK=testnet

# --- Deploy env only (deploy/<network>.env) ---
DEPLOYER_PRIVATE_KEY=0x<64-hex>
PPOI1_PRIVATE_KEY=0x<64-hex>
PPOI2_PRIVATE_KEY=0x<64-hex>
PPOI1_TOKEN=<random-32+>
PPOI2_TOKEN=<random-32+>
# Testnet mock Collector Crypt quote signer.
CC_QUOTE_PRIVATE_KEY=0x<64-hex>

# --- Scripts ---
# scripts/dev-stack.ts fund: wallet that mints and deposits test USDG.
FUND_PRIVATE_KEY=0x<64-hex>
# scripts/testnet-rip.ts: test wallet phrase, words joined by '-'.
TEST_WALLET_MNEMONIC=<word-word-...>
# circuits/scripts/ceremony.ts: ceremony working directory.
CEREMONY_DIR=
# scripts/monitor.ts: lookback window, large-withdrawal threshold (USDG), optional alert webhook.
LOOKBACK_MINUTES=60
WITHDRAW_ALERT_USDG=10000
ALERT_WEBHOOK_URL=

# --- Foundry (contracts/script/*.s.sol, contracts/foundry.toml) ---
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
OWNER=
SAFE=
GUARDIAN=
OPERATOR=
# Comma-separated ppoi provider addresses.
PROVIDERS=
USDG=
BURN_SINK=
MAX_DEPOSIT=
MAX_TOTAL=
MOCK_VERIFIERS=
CC_QUOTE_SIGNER=
