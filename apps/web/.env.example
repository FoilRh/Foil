# Public origin for canonical URLs and social metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep RPC, relayer and provider secrets in backend services, never NEXT_PUBLIC_*.
# Foil OHTTP relay (services/ohttp-relay). Unset keeps the dashboard in local example mode.
NEXT_PUBLIC_OHTTP_RELAY_URL=
# Pinned OHTTP gateway key config (hex). Never fetched from the relay.
NEXT_PUBLIC_OHTTP_KEY_CONFIG=
# Chrome ID of the Foil extension (apps/extension) for browser-mode ripping.
NEXT_PUBLIC_FOIL_EXTENSION_ID=
# 4663 = Robinhood Chain (default), 46630 = Robinhood Chain testnet.
NEXT_PUBLIC_CHAIN_ID=
